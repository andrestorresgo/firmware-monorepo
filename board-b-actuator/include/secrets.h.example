#pragma once

// Actuator (Board B) Configuration Template
// Board B operates offline via ESP-NOW and does not connect directly to the Internet or MQTT.
// This header is reserved for node-specific hardware identity or optional encryption keys.

#define ACTUATOR_NODE_ID 0x01
#define ESPNOW_PMK_KEY "pmk1234567890123" // 16-byte Primary Master Key if encryption enabled
#define ESPNOW_LMK_KEY "lmk1234567890123" // 16-byte Local Master Key if encryption enabled
